# ─── Solana RPC ─────────────────────────────────────────────
# Wajib mendukung WebSocket subscriptions untuk onLogs
RPC_URL=https://api.mainnet-beta.solana.com
# Opsional: endpoint WS terpisah
# WS_URL=wss://api.mainnet-beta.solana.com

# ─── Telegram ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Filter & backfill ──────────────────────────────────────
# Nilai deposit minimal dalam USD yang dilaporkan (0 = semua)
MIN_DEPOSIT_USD=0
# Berapa menit ke belakang yang di-scan saat startup
BACKFILL_MINUTES=10

# ─── Opsional ───────────────────────────────────────────────
# Basis URL tautan "Lihat di LP Agent" di pesan Telegram.
# LPAGENT_BASE=https://app.lpagent.io
